<component type="desktop-application">
  <id>dev.apiark.app</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <name>Apiark</name>
  <summary>Offline first REST API client</summary>
  <description>
    <p>The API platform that respects your privacy, your RAM, and your Git workflow.</p>
    <p>Features:</p>
    <ul>
      <li>Offline first API client</li>
      <li>Sync collections with Git</li>
      <li>REST, GraphQL, WebSocket, SSE, gRPC and MQTT support</li>
      <li>Lightweight and low on memory</li>
    </ul>
  </description>
  <launchable type="desktop-id">dev.apiark.app.desktop</launchable>
  <provides>
    <id>dev.apiark.app.desktop</id>
  </provides>
